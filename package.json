{
  "name": "emotionlab-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/EmilyGonzalezU/Emotionlab-Frontend.git"
  },
  "scripts": {
    "dev": "vite",
    "configure:api": "node scripts/configure-api-from-terraform.mjs",
    "prebuild": "node scripts/validate-api-url.mjs",
    "build": "vite build",
    "electron": "electron .",
    "electron:build": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "test": "node --test",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.4.6"
  },
  "build": {
    "appId": "cl.emotionlab.desktop",
    "productName": "EmotionLab",
    "icon": "public/icon.ico",
    "artifactName": "EmotionLab-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "EmilyGonzalezU",
        "repo": "Emotionlab-Frontend"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "public/icon.ico"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "EmotionLab",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EmotionLab"
    }
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "minimatch": "11.0.1"
  }
}
